# Copy to .env for local runs. In GitHub Actions these are repository secrets.
# Claude Pro/Max subscription token: run `claude setup-token` and paste the result here.
# When set, Claude (Opus) writes the briefing + script; Gemini stays as the fallback.
CLAUDE_CODE_OAUTH_TOKEN=

# Free key from aistudio.google.com/apikey — covers both writing and voices
GEMINI_API_KEY=
# Only needed with NLNEWS_WRITER=claude (paid API, separate from a Claude Pro subscription)
ANTHROPIC_API_KEY=

# Email backup delivery (Gmail: create an app password at myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# Podcast feed: random path segment so the feed URL isn't guessable, e.g. `openssl rand -hex 12`
FEED_SECRET_PATH=
# Public base URL of the GitHub Pages site, e.g. https://circlenostar23-cloud.github.io/netherlands-news
SITE_BASE_URL=

# Optional overrides
# NLNEWS_WRITER=gemini          # or claude
# NLNEWS_GEMINI_MODEL=gemini-3.8-flash
# NLNEWS_CLAUDE_MODEL=claude-sonnet-5
# NLNEWS_TTS_MODEL=gemini-3.8-flash-tts
